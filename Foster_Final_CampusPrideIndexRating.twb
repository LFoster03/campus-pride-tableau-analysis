              <calculation class='tableau' formula='IF [hbcu] = TRUE &#13;&#10;    OR [hispanic_serving] = TRUE&#13;&#10;    OR [aapi_serving] = TRUE&#13;&#10;    OR [other_minority_serving] = TRUE&#13;&#10;THEN &quot;Minority-serving&quot;&#13;&#10;ELSE &quot;Non-minority&quot;&#13;&#10;END' />

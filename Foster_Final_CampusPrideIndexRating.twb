            <column caption='Community' datatype='boolean' name='[community]' role='dimension' type='nominal' />
            <column caption='Doctoral' datatype='boolean' name='[doctoral]' role='dimension' type='nominal' />
            <column caption='Masters' datatype='boolean' name='[masters]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_1625120928682001]' derivation='None' name='[none:Calculation_1625120928682001:nk]' pivot='key' type='nominal' />
            <column-instance column='[campus_name]' derivation='None' name='[none:campus_name:nk]' pivot='key' type='nominal' />
            <column caption='Rating' datatype='real' name='[rating]' role='measure' type='quantitative' />
            <column-instance column='[rating]' derivation='Sum' name='[sum:rating:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <manual-sort column='[federated.0dtr0w81ypf1nk17dvv421rsyqiq].[none:Calculation_1625120928682001:nk]' direction='ASC'>
            <dictionary>
              <bucket>&quot;Baccalaureate College&quot;</bucket>
              <bucket>&quot;Doctoral University&quot;</bucket>
              <bucket>&quot;Master&apos;s University&quot;</bucket>
              <bucket>&quot;Community College&quot;</bucket>
              <bucket>&quot;Unknown&quot;</bucket>
            </dictionary>
          </manual-sort>

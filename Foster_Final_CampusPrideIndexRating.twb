      <column caption='Private Rating' datatype='real' name='[Calculation_1625119902007297]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [private] = TRUE THEN [rating] END' />
      </column>
      <column caption='Public Rating' datatype='real' name='[Calculation_1625119902105602]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [public] = TRUE THEN [rating] END' />
      </column>
      <column caption='Campus Type' datatype='string' name='[Calculation_1625119905189891]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [public] = TRUE THEN &quot;Public&quot;&#13;&#10;ELSE &quot;Private&quot;&#13;&#10;END' />
      </column>
      <column caption='Length Rating' datatype='real' name='[Calculation_1625119926079492]' role='measure' type='quantitative'>

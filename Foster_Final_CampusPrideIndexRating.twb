      </style>
      <size maxheight='964' maxwidth='1016' minheight='964' minwidth='1016' />
      <zones>
        <zone h='100000' id='2' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='98340' id='7' param='vert' removable='false' type-v2='layout-flow' w='98426' x='787' y='830'>
            <zone h='11826' id='8' type-v2='title' w='98426' x='787' y='830'>
              <zone-style>
                <format attr='border-color' value='#000000' />
                <format attr='border-style' value='none' />
                <format attr='border-width' value='0' />
                <format attr='margin' value='4' />
              </zone-style>
            </zone>
            <zone h='86514' id='1' param='vert' removable='false' type-v2='layout-flow' w='98426' x='787' y='12656'>
              <zone fixed-size='130' h='13485' id='4' is-fixed='true' paired-zone-id='5' removable='false' type-v2='flipboard-nav' w='98426' x='787' y='12656' />
              <zone h='73029' id='5' paired-zone-id='4' removable='false' type-v2='flipboard' w='98426' x='787' y='26141'>
                <flipboard active-id='1' nav-type='caption' show-nav-arrows='true'>
                  <story-points>
                    <story-point caption='Many states have high Pride Index ratings (4+ stars), indicating inclusive campus environments, but MEI scores in those same states are often much lower. This suggests that strong campus inclusion does not always align with statewide LGBTQ+ protections.' captured-sheet='1: Average Ratings by State' id='1'>
                      <capturedDeltas>
                        <worksheet name='Goal 1'>
                          <style delta-type='added'>
                            <style-rule element='axis'>
                              <encoding attr='space' class='0' field='[federated.1vi4e200wddiqj1djf4ts1ddk6rq].[Latitude (generated)]' field-type='quantitative' max='6496167.1056445688' min='2665729.0117445365' projection='EPSG:3857' range-type='fixed' scope='rows' type='space' />
                              <encoding attr='space' class='0' field='[federated.1vi4e200wddiqj1djf4ts1ddk6rq].[Longitude (generated)]' field-type='quantitative' max='-5842022.1859318502' min='-15418117.277986996' projection='EPSG:3857' range-type='fixed' scope='cols' type='space' />
                            </style-rule>
                          </style>
                        </worksheet>
                      </capturedDeltas>
                    </story-point>
                    <story-point caption='Doctoral institutions show the most consistently high Pride Index ratings, while community colleges display the widest range and lowest minimum ratings. However, most institutions across all degree levels fall between 3 and 5 stars, indicating generally strong LGBTQ+ inclusion regardless of institutional complexity.' captured-sheet='Goal 2' id='2' />
                    <story-point caption='Minority-serving and non-minority-serving campuses have nearly identical Pride Index ratings, indicating similar levels of LGBTQ+ inclusion. Some overlap exists because campuses may serve multiple minority groups.' captured-sheet='3: Minority Serving Campuses' id='3' />
                    <story-point caption='Pride Index ratings are highest in large urban campuses (4.14) and gradually decrease as community size decreases, with rural and very small town campuses averaging around 3.56–3.54. This indicates that community context may influence inclusion efforts.' captured-sheet='Goal 4' id='4' />
                    <story-point caption='Public colleges tend to have higher Pride Index ratings, with more campuses in green and very few low ratings. Private colleges have fewer high-rating campuses and more mid- and low-range ratings, including two campuses in dark red (1.5 stars).' captured-sheet='Goal 5' id='5' />
                    <story-point caption='Private campuses are mostly small and show wide variation in Pride Index ratings, while public campuses are larger and consistently high. Few campuses appear in the low-rating, high-enrollment quadrant.' captured-sheet='Goal 6' id='6' />
                  </story-points>
                </flipboard>
              </zone>
            </zone>
          </zone>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='8' />

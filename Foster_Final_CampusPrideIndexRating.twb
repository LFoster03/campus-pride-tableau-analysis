            <column caption='Degree Level Category' datatype='string' name='[Calculation_1625120928682001]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ISNULL([doctoral]) AND ISNULL([masters]) AND ISNULL([baccalaureate]) AND ISNULL([community])&#13;&#10;THEN &quot;Unknown&quot;&#13;&#10;ELSEIF [community]=TRUE&#13;&#10;THEN &quot;Community College&quot;&#13;&#10;ELSEIF [doctoral]=TRUE&#13;&#10;THEN &quot;Doctoral University&quot;&#13;&#10;ELSEIF [masters]=TRUE&#13;&#10;THEN &quot;Master&apos;s University&quot;&#13;&#10;ELSEIF [baccalaureate]=TRUE&#13;&#10;THEN &quot;Baccalaureate College&quot;&#13;&#10;END' />

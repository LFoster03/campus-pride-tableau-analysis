      <aliases enabled='yes' />
      <column caption='Degree Level Count' datatype='integer' name='[Calculation_1625120910696460]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ISNULL([doctoral])&#13;&#10;AND ISNULL([masters])&#13;&#10;AND ISNULL([baccalaureate])&#13;&#10;AND ISNULL([community])&#13;&#10;THEN NULL&#13;&#10;&#13;&#10;ELSE&#13;&#10;INT(IF [baccalaureate]=TRUE THEN 1 ELSE 0 END)&#13;&#10;+&#13;&#10;INT(IF [masters]=TRUE THEN 1 ELSE 0 END)&#13;&#10;+&#13;&#10;INT(IF [doctoral]=TRUE THEN 1 ELSE 0 END)&#13;&#10;END' />
      </column>
      <column caption='Degree Data Status' datatype='string' name='[Calculation_1625120910864397]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([Calculation_1625120910696460])&#13;&#10;THEN &quot;Unknown&quot;&#13;&#10;ELSE &quot;Known&quot;&#13;&#10;END' />
      </column>
      <column caption='Degree Level Category' datatype='string' name='[Calculation_1625120928682001]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([doctoral]) AND ISNULL([masters]) AND ISNULL([baccalaureate]) AND ISNULL([community])&#13;&#10;THEN &quot;Unknown&quot;&#13;&#10;ELSEIF [community]=TRUE&#13;&#10;THEN &quot;Community College&quot;&#13;&#10;ELSEIF [doctoral]=TRUE&#13;&#10;THEN &quot;Doctoral University&quot;&#13;&#10;ELSEIF [masters]=TRUE&#13;&#10;THEN &quot;Master&apos;s University&quot;&#13;&#10;ELSEIF [baccalaureate]=TRUE&#13;&#10;THEN &quot;Baccalaureate College&quot;&#13;&#10;END' />
      </column>
      <column caption='Minority Label' datatype='string' name='[Calculation_1625120937660438]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [hbcu] = TRUE THEN &quot;HBCU&quot;&#13;&#10;ELSEIF [hispanic_serving] = TRUE THEN &quot;Hispanic-serving&quot;&#13;&#10;ELSEIF [aapi_serving] = TRUE THEN &quot;AAPI-serving&quot;&#13;&#10;ELSEIF [other_minority_serving] = TRUE THEN &quot;Other Minority-serving&quot;&#13;&#10;ELSE &quot;Non-minority&quot;&#13;&#10;END' />
      </column>
      <column caption='Minority-serving Status' datatype='string' name='[Calculation_1625120939946007]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [hbcu] = TRUE &#13;&#10;    OR [hispanic_serving] = TRUE&#13;&#10;    OR [aapi_serving] = TRUE&#13;&#10;    OR [other_minority_serving] = TRUE&#13;&#10;THEN &quot;Minority-serving&quot;&#13;&#10;ELSE &quot;Non-minority&quot;&#13;&#10;END' />
      </column>
      <column caption='Campus Characteristics' datatype='table' name='[__tableau_internal_object_id__].[Campus Characteristics_A110E3049C01419DABA6923BC5BA86DE]' role='measure' type='quantitative' />
      <column caption='Aapi Serving' datatype='boolean' name='[aapi_serving]' role='dimension' type='nominal' />

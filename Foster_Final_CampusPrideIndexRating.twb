    <dashboard name='Data Story Guide' type='storyboard'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Campus Pride Index: A Guide to LGBTQ+ Inclusive Colleges
</run>
            <run fontsize='10'>By: Lindsay Foster
Date: February 26, 2026</run>
          </formatted-text>
        </title>
      </layout-options>
      <style>
        <style-rule element='story-description'>
          <format attr='background-color' id='story-description_10' value='#00000000' />
          <format attr='border-width' id='story-description_10' value='0' />

      <column caption='City' datatype='string' name='[campus_location - Split 1]' role='dimension' semantic-role='[City].[Name]' type='nominal' user:SplitFieldIndex='1' user:SplitFieldOrigin='[federated.0dtr0w81ypf1nk17dvv421rsyqiq].[campus_location]'>
        <calculation class='tableau' formula='TRIM( SPLIT( [campus_location], &quot;,&quot;, 1 ) )' />
